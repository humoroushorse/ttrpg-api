# Keycloak Admin Credentials
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=your_admin_password_here

# Test User Credentials
TEST_ADMIN_USERNAME=test_admin
TEST_ADMIN_PASSWORD=your_test_admin_password_here
TEST_USER_USERNAME=test_user
TEST_USER_PASSWORD=your_test_user_password_here

# Database Credentials
DATABASE_PASSWORD=your_database_password_here

# Environment Selection (local, staging, production)
ENV=local

# Service Base URLs
GO_AUTH_BASE_URL=http://localhost:8081
GO_SPRINT_BASE_URL=http://localhost:8080
