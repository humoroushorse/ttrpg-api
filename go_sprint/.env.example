# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=sprint_management
POSTGRES_PORT=5432
AUTH_DB=auth
KEYCLOAK_DB=keycloak

# NATS Configuration
NATS_CLIENT_PORT=4222
NATS_HTTP_PORT=8222
NATS_CLUSTER_PORT=6222

# Keycloak Configuration
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
KEYCLOAK_HOSTNAME=localhost
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=sprint-management
KEYCLOAK_CLIENT_ID=sprint-client

# Service Ports
AUTH_SERVICE_PORT=8081
SPRINT_SERVICE_PORT=8003

# Application Configuration
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:4204,http://localhost:3000

# Docker Registry (for production)
DOCKER_REGISTRY=ghcr.io
AUTH_VERSION=latest
SPRINT_VERSION=latest
